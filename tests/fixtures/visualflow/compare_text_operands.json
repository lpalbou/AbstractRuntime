{
  "about": "Text next to a number or true/false in Compare: the text is read exactly by the Flow editor's literal grammar (pinLiterals.ts parseLiteralText), or the step is refused. `a` is the typed side; `text` is the other side; `op` the operator; `expected` the answer, or \"refused\".",
  "cases": [
    {"a": 5, "text": "5", "op": "==", "expected": true},
    {"a": 5, "text": " 5 ", "op": "==", "expected": true},
    {"a": 5, "text": "5.0", "op": "==", "expected": true},
    {"a": 5, "text": "+5", "op": "==", "expected": true},
    {"a": 10, "text": "9", "op": ">", "expected": true},
    {"a": 10, "text": "9", "op": "<", "expected": false},
    {"a": -2.5, "text": "-2.5", "op": "==", "expected": true},
    {"a": 0.5, "text": ".5", "op": "==", "expected": true},
    {"a": 1000, "text": "1e3", "op": "==", "expected": true},
    {"a": 1000, "text": "1E3", "op": "<=", "expected": true},
    {"a": 5, "text": "6", "op": "!=", "expected": true},
    {"a": 9007199254740993, "text": "9007199254740993", "op": "==", "expected": true},
    {"a": 9007199254740992, "text": "9007199254740993", "op": "==", "expected": false},
    {"a": true, "text": "true", "op": "==", "expected": true},
    {"a": true, "text": " TRUE ", "op": "==", "expected": true},
    {"a": false, "text": "False", "op": "==", "expected": true},
    {"a": true, "text": "false", "op": "==", "expected": false},
    {"a": 2.5, "text": "x", "op": "==", "expected": "refused"},
    {"a": 5, "text": "abc", "op": "!=", "expected": "refused"},
    {"a": 1000, "text": "1_000", "op": "==", "expected": "refused"},
    {"a": 5, "text": "５", "op": "==", "expected": "refused"},
    {"a": 5, "text": "nan", "op": "!=", "expected": "refused"},
    {"a": 5, "text": "inf", "op": "<", "expected": "refused"},
    {"a": 5, "text": "-Infinity", "op": "<", "expected": "refused"},
    {"a": 5, "text": "1e999", "op": "<", "expected": "refused"},
    {"a": 16, "text": "0x10", "op": "==", "expected": "refused"},
    {"a": 0, "text": "", "op": "==", "expected": "refused"},
    {"a": 0, "text": "   ", "op": "==", "expected": "refused"},
    {"a": 5, "text": "5 apples", "op": "==", "expected": "refused"},
    {"a": 1, "text": "true", "op": "==", "expected": "refused"},
    {"a": true, "text": "yes", "op": "==", "expected": "refused"},
    {"a": true, "text": "1", "op": "==", "expected": "refused"},
    {"a": false, "text": "", "op": "==", "expected": "refused"}
  ]
}
